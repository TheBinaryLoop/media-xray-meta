{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/TheBinaryLoop/media-xray-meta/master/schema/v1/xray.schema.json",
  "title": "media-xray v1: timeline",
  "description": "The language-independent part of the time-coded metadata (who is on screen, what is playing, scenes, skippable segments) for one release of one film or episode. Everything a viewer reads, and the anchors that align the timeline, live in one language file per language beside it (language.schema.json). See docs/format.md for the semantics this schema cannot express.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "title",
    "reference"
  ],
  "properties": {
    "$schema": {
      "description": "Optional editor hint pointing at this schema. Ignored by consumers.",
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "title": {
      "$ref": "#/$defs/title"
    },
    "reference": {
      "$ref": "#/$defs/reference"
    },
    "people": {
      "description": "The item's cast, keyed by a short slug that is local to the item. Appearances refer to these keys; a person need not have any.",
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/slug"
      },
      "additionalProperties": {
        "$ref": "#/$defs/person"
      }
    },
    "appearances": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/appearance"
      }
    },
    "scenes": {
      "description": "Scenes with stable ids; their titles live in the language files.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/scene"
      }
    },
    "segments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/segment"
      }
    },
    "music": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/cue"
      }
    }
  },
  "$defs": {
    "time": {
      "description": "A position on the reference timeline, HH:MM:SS.mmm, counted from the first frame of the release.",
      "type": "string",
      "pattern": "^[0-9]{2}:[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}$"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "language": {
      "description": "A BCP 47 language tag in lower case, e.g. en, de, pt-br. Also used in file names.",
      "type": "string",
      "pattern": "^[a-z]{2,3}(-[a-z0-9]{2,8})*$"
    },
    "tmdb": {
      "type": "integer",
      "minimum": 1
    },
    "tvdb": {
      "type": "integer",
      "minimum": 1
    },
    "imdbTitle": {
      "type": "string",
      "pattern": "^tt[0-9]{7,}$"
    },
    "imdbName": {
      "type": "string",
      "pattern": "^nm[0-9]{7,}$"
    },
    "wikidata": {
      "type": "string",
      "pattern": "^Q[1-9][0-9]*$"
    },
    "musicbrainz": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "titleIds": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "tmdb": {
          "$ref": "#/$defs/tmdb"
        },
        "imdb": {
          "$ref": "#/$defs/imdbTitle"
        },
        "tvdb": {
          "$ref": "#/$defs/tvdb"
        },
        "wikidata": {
          "$ref": "#/$defs/wikidata"
        }
      }
    },
    "title": {
      "description": "What this file describes. Films are keyed by their TMDB id, episodes by their series' TMDB id plus season and episode number.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "name"
      ],
      "properties": {
        "kind": {
          "enum": [
            "movie",
            "episode"
          ]
        },
        "name": {
          "description": "The title as a reviewer would recognise it. A label for humans reading the file, not data to display: players take the displayed title, in the viewer's language, from the ids.",
          "type": "string",
          "minLength": 1
        },
        "year": {
          "type": "integer",
          "minimum": 1870
        },
        "ids": {
          "$ref": "#/$defs/titleIds"
        },
        "series": {
          "$ref": "#/$defs/titleIds"
        },
        "season": {
          "type": "integer",
          "minimum": 0
        },
        "episode": {
          "type": "integer",
          "minimum": 0
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "movie"
              }
            }
          },
          "then": {
            "required": [
              "ids"
            ],
            "properties": {
              "ids": {
                "required": [
                  "tmdb"
                ]
              },
              "series": false,
              "season": false,
              "episode": false
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "episode"
              }
            }
          },
          "then": {
            "required": [
              "series",
              "season",
              "episode"
            ],
            "properties": {
              "series": {
                "required": [
                  "tmdb"
                ]
              }
            }
          }
        }
      ]
    },
    "reference": {
      "description": "The one release every time in this file is measured against.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "edition",
        "runtime"
      ],
      "properties": {
        "edition": {
          "description": "Which cut. Also the start of the file names. Conventionally theatrical, extended, directors-cut, unrated for films and original for episodes.",
          "$ref": "#/$defs/slug"
        },
        "runtime": {
          "description": "Length of the reference release, first frame to last.",
          "$ref": "#/$defs/time"
        },
        "frameRate": {
          "description": "Nominal frame rate as a rational, e.g. 24000/1001 or 25.",
          "type": "string",
          "pattern": "^[1-9][0-9]*(/[1-9][0-9]*)?$"
        },
        "release": {
          "description": "Free-text description of the source the times were taken from, e.g. 2017 Criterion Blu-ray.",
          "type": "string",
          "minLength": 1
        }
      }
    },
    "person": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "anyOf": [
        {
          "required": [
            "tmdb"
          ]
        },
        {
          "required": [
            "imdb"
          ]
        },
        {
          "required": [
            "wikidata"
          ]
        }
      ],
      "properties": {
        "name": {
          "description": "The performer's name. A label for reviewers; consumers resolve the ids for anything they display. Character names live in the language files.",
          "type": "string",
          "minLength": 1
        },
        "tmdb": {
          "$ref": "#/$defs/tmdb"
        },
        "imdb": {
          "$ref": "#/$defs/imdbName"
        },
        "wikidata": {
          "$ref": "#/$defs/wikidata"
        },
        "characterWikidata": {
          "$ref": "#/$defs/wikidata"
        },
        "credit": {
          "description": "main for the item's regular cast, guest for a guest appearance.",
          "enum": [
            "main",
            "guest"
          ]
        },
        "billing": {
          "description": "Position in the credited cast list, lowest first. Billing order is information: it says who leads.",
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "provenance": {
      "description": "How an entry came to exist. Omitting source means a person entered it, and a person's entry counts as reviewed.",
      "type": "object",
      "properties": {
        "source": {
          "enum": [
            "human",
            "face",
            "speaker",
            "audio-fingerprint",
            "shot-detection",
            "video-analysis",
            "subtitles",
            "language-model"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "reviewed": {
          "type": "boolean"
        }
      },
      "if": {
        "required": [
          "source"
        ],
        "properties": {
          "source": {
            "not": {
              "const": "human"
            }
          }
        }
      },
      "then": {
        "required": [
          "reviewed",
          "confidence"
        ]
      }
    },
    "span": {
      "type": "object",
      "required": [
        "from",
        "to"
      ],
      "properties": {
        "from": {
          "$ref": "#/$defs/time"
        },
        "to": {
          "$ref": "#/$defs/time"
        }
      }
    },
    "appearance": {
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/span"
        },
        {
          "$ref": "#/$defs/provenance"
        }
      ],
      "required": [
        "who"
      ],
      "unevaluatedProperties": false,
      "properties": {
        "who": {
          "description": "A key of people.",
          "$ref": "#/$defs/slug"
        },
        "presence": {
          "description": "on-screen (the default) or voice only, e.g. a narrator or someone on the phone.",
          "enum": [
            "on-screen",
            "voice"
          ]
        }
      }
    },
    "scene": {
      "description": "A named stretch of the film. The name is in each language file, keyed by id.",
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/span"
        },
        {
          "$ref": "#/$defs/provenance"
        }
      ],
      "required": [
        "id"
      ],
      "unevaluatedProperties": false,
      "properties": {
        "id": {
          "description": "Stable within this item; language files refer to the scene by it.",
          "$ref": "#/$defs/slug"
        }
      }
    },
    "segment": {
      "description": "A stretch a player may offer to skip. The types are Jellyfin's media segment types.",
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/span"
        },
        {
          "$ref": "#/$defs/provenance"
        }
      ],
      "required": [
        "type"
      ],
      "unevaluatedProperties": false,
      "properties": {
        "type": {
          "enum": [
            "intro",
            "outro",
            "recap",
            "preview",
            "commercial"
          ]
        }
      }
    },
    "cue": {
      "description": "A piece of music audible between from and to.",
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/span"
        },
        {
          "$ref": "#/$defs/provenance"
        }
      ],
      "required": [
        "recording"
      ],
      "unevaluatedProperties": false,
      "properties": {
        "recording": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "title"
          ],
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1
            },
            "artist": {
              "type": "string",
              "minLength": 1
            },
            "musicbrainz": {
              "description": "MusicBrainz recording id.",
              "$ref": "#/$defs/musicbrainz"
            }
          }
        },
        "usage": {
          "description": "background (score or a song under the scene), on-screen (performed or played within the story), opening or closing titles.",
          "enum": [
            "background",
            "on-screen",
            "opening",
            "closing"
          ]
        }
      }
    }
  }
}
