{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/TheBinaryLoop/media-xray-meta/master/schema/v1/xray.schema.json",
  "title": "media-xray v1",
  "description": "Time-coded scene metadata (who is on screen, what is playing, named scenes, skippable segments, trivia) for one release of one film or episode. See docs/format.md for the semantics this schema cannot express.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "title", "reference", "anchors"],
  "properties": {
    "$schema": {
      "description": "Optional editor hint pointing at this schema. Ignored by consumers.",
      "type": "string"
    },
    "schemaVersion": { "const": 1 },
    "title": { "$ref": "#/$defs/title" },
    "reference": { "$ref": "#/$defs/reference" },
    "anchors": {
      "description": "Recognisable moments that let a consumer map this file's timeline onto its own copy of the release. At least two, spread across the runtime.",
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "#/$defs/anchor" }
    },
    "people": {
      "description": "Everyone referenced by an appearance, keyed by a short slug that is local to this file.",
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/slug" },
      "additionalProperties": { "$ref": "#/$defs/person" }
    },
    "appearances": { "type": "array", "items": { "$ref": "#/$defs/appearance" } },
    "scenes": { "type": "array", "items": { "$ref": "#/$defs/scene" } },
    "segments": { "type": "array", "items": { "$ref": "#/$defs/segment" } },
    "music": { "type": "array", "items": { "$ref": "#/$defs/cue" } },
    "trivia": { "type": "array", "items": { "$ref": "#/$defs/trivium" } }
  },

  "$defs": {
    "time": {
      "description": "A position on the reference timeline, HH:MM:SS.mmm, counted from the first frame of the release.",
      "type": "string",
      "pattern": "^[0-9]{2}:[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}$"
    },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "language": {
      "description": "A BCP 47 language tag, e.g. en, de, pt-BR.",
      "type": "string",
      "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
    },
    "localized": {
      "description": "Text keyed by language tag. A language is absent rather than empty when nobody has written it.",
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/language" },
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "tmdb": { "type": "integer", "minimum": 1 },
    "tvdb": { "type": "integer", "minimum": 1 },
    "imdbTitle": { "type": "string", "pattern": "^tt[0-9]{7,}$" },
    "imdbName": { "type": "string", "pattern": "^nm[0-9]{7,}$" },
    "wikidata": { "type": "string", "pattern": "^Q[1-9][0-9]*$" },
    "musicbrainz": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },

    "titleIds": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "tmdb": { "$ref": "#/$defs/tmdb" },
        "imdb": { "$ref": "#/$defs/imdbTitle" },
        "tvdb": { "$ref": "#/$defs/tvdb" },
        "wikidata": { "$ref": "#/$defs/wikidata" }
      }
    },
    "title": {
      "description": "What this file describes. Films are keyed by their TMDB id, episodes by their series' TMDB id plus season and episode number.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name"],
      "properties": {
        "kind": { "enum": ["movie", "episode"] },
        "name": {
          "description": "The title as a reviewer would recognise it. A label for humans reading the file, not data to display.",
          "type": "string",
          "minLength": 1
        },
        "year": { "type": "integer", "minimum": 1870 },
        "ids": { "$ref": "#/$defs/titleIds" },
        "series": { "$ref": "#/$defs/titleIds" },
        "season": { "type": "integer", "minimum": 0 },
        "episode": { "type": "integer", "minimum": 0 }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "movie" } } },
          "then": {
            "required": ["ids"],
            "properties": {
              "ids": { "required": ["tmdb"] },
              "series": false,
              "season": false,
              "episode": false
            }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "episode" } } },
          "then": {
            "required": ["series", "season", "episode"],
            "properties": { "series": { "required": ["tmdb"] } }
          }
        }
      ]
    },
    "reference": {
      "description": "The one release every time in this file is measured against.",
      "type": "object",
      "additionalProperties": false,
      "required": ["edition", "runtime"],
      "properties": {
        "edition": {
          "description": "Which cut. Also the file name. Conventionally theatrical, extended, directors-cut, unrated for films and original for episodes.",
          "$ref": "#/$defs/slug"
        },
        "runtime": {
          "description": "Length of the reference release, first frame to last.",
          "$ref": "#/$defs/time"
        },
        "frameRate": {
          "description": "Nominal frame rate as a rational, e.g. 24000/1001 or 25.",
          "type": "string",
          "pattern": "^[1-9][0-9]*(/[1-9][0-9]*)?$"
        },
        "release": {
          "description": "Free-text description of the source the times were taken from, e.g. 2017 Criterion Blu-ray.",
          "type": "string",
          "minLength": 1
        }
      }
    },

    "anchor": {
      "oneOf": [
        {
          "description": "A line of dialogue as it appears in the subtitles, timed to the reference.",
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "from", "to", "language", "text"],
          "properties": {
            "kind": { "const": "subtitle" },
            "from": { "$ref": "#/$defs/time" },
            "to": { "$ref": "#/$defs/time" },
            "language": { "$ref": "#/$defs/language" },
            "text": { "type": "string", "minLength": 1, "maxLength": 200 }
          }
        },
        {
          "description": "A Chromaprint fingerprint of the audio between from and to, as printed by fpcalc (compressed, base64url).",
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "from", "to", "fingerprint"],
          "properties": {
            "kind": { "const": "chromaprint" },
            "from": { "$ref": "#/$defs/time" },
            "to": { "$ref": "#/$defs/time" },
            "algorithm": { "type": "integer", "minimum": 0, "default": 2 },
            "fingerprint": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" }
          }
        }
      ]
    },

    "person": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "anyOf": [{ "required": ["tmdb"] }, { "required": ["imdb"] }, { "required": ["wikidata"] }],
      "properties": {
        "name": {
          "description": "The performer's name. A label for reviewers; consumers resolve the ids for anything they display.",
          "type": "string",
          "minLength": 1
        },
        "character": {
          "description": "Who they play here, as credited.",
          "type": "string",
          "minLength": 1
        },
        "tmdb": { "$ref": "#/$defs/tmdb" },
        "imdb": { "$ref": "#/$defs/imdbName" },
        "wikidata": { "$ref": "#/$defs/wikidata" },
        "characterWikidata": { "$ref": "#/$defs/wikidata" }
      }
    },

    "provenance": {
      "description": "How an entry came to exist. Omitting source means a person entered it, and a person's entry counts as reviewed.",
      "type": "object",
      "properties": {
        "source": { "enum": ["human", "face", "speaker", "audio-fingerprint", "shot-detection", "subtitles"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "reviewed": { "type": "boolean" }
      },
      "if": {
        "required": ["source"],
        "properties": { "source": { "not": { "const": "human" } } }
      },
      "then": { "required": ["reviewed"] }
    },
    "span": {
      "type": "object",
      "required": ["from", "to"],
      "properties": {
        "from": { "$ref": "#/$defs/time" },
        "to": { "$ref": "#/$defs/time" }
      }
    },

    "appearance": {
      "type": "object",
      "allOf": [{ "$ref": "#/$defs/span" }, { "$ref": "#/$defs/provenance" }],
      "required": ["who"],
      "unevaluatedProperties": false,
      "properties": {
        "who": { "description": "A key of people.", "$ref": "#/$defs/slug" },
        "presence": {
          "description": "on-screen (the default) or voice only, e.g. a narrator or someone on the phone.",
          "enum": ["on-screen", "voice"]
        }
      }
    },
    "scene": {
      "type": "object",
      "allOf": [{ "$ref": "#/$defs/span" }, { "$ref": "#/$defs/provenance" }],
      "required": ["title"],
      "unevaluatedProperties": false,
      "properties": {
        "title": { "$ref": "#/$defs/localized" }
      }
    },
    "segment": {
      "description": "A stretch a player may offer to skip. The types are Jellyfin's media segment types.",
      "type": "object",
      "allOf": [{ "$ref": "#/$defs/span" }, { "$ref": "#/$defs/provenance" }],
      "required": ["type"],
      "unevaluatedProperties": false,
      "properties": {
        "type": { "enum": ["intro", "outro", "recap", "preview", "commercial"] }
      }
    },
    "cue": {
      "description": "A piece of music audible between from and to.",
      "type": "object",
      "allOf": [{ "$ref": "#/$defs/span" }, { "$ref": "#/$defs/provenance" }],
      "required": ["recording"],
      "unevaluatedProperties": false,
      "properties": {
        "recording": {
          "type": "object",
          "additionalProperties": false,
          "required": ["title"],
          "properties": {
            "title": { "type": "string", "minLength": 1 },
            "artist": { "type": "string", "minLength": 1 },
            "musicbrainz": { "description": "MusicBrainz recording id.", "$ref": "#/$defs/musicbrainz" }
          }
        },
        "usage": {
          "description": "background (score or a song under the scene), on-screen (performed or played within the story), opening or closing titles.",
          "enum": ["background", "on-screen", "opening", "closing"]
        }
      }
    },
    "trivium": {
      "description": "A fact about the moment, written in the contributor's own words, with a source.",
      "type": "object",
      "allOf": [{ "$ref": "#/$defs/span" }, { "$ref": "#/$defs/provenance" }],
      "required": ["text", "sources"],
      "unevaluatedProperties": false,
      "properties": {
        "text": { "$ref": "#/$defs/localized" },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "format": "uri", "pattern": "^https?://" }
        },
        "spoiler": { "type": "boolean" }
      }
    }
  }
}
